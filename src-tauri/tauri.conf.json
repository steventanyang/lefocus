{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lefocus",
  "version": "1.1.8",
  "identifier": "com.stevenyang.lefocus",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "lefocus",
        "width": 800,
        "height": 600,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/libMacOSSensing.dylib"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzQkRDREY1OUJGOTRBMDQKUldRRVN2bWI5YzI5ODl1a2tUd2tKdlMyWUxxekM4R0pPWDRvMnhNLy9zdm5YcjhRa1FJdTdPU3kK",
      "endpoints": [
        "https://github.com/steventanyang/lefocus/releases/latest/download/latest.json"
      ]
    }
  }
}
